PORT=3000
HOST=0.0.0.0
PUBLIC_MODE=0
PUBLIC_MATCHING=0
PUBLIC_TEST_CODE=
# Set your account's Public ID here to assign the owner role securely.
OWNER_PUBLIC_ID=
# Optional: use a long random secret in production. If blank, it is stored in data/.jwt-secret.
JWT_SECRET=
# Neon PostgreSQL connection string; keep this secret and set it only in Render Environment.
DATABASE_URL=

# Stripe Checkout — use test keys first. Configure a webhook at /api/billing/stripe/webhook.
# Never commit real keys. APP_PUBLIC_URL must be the canonical HTTPS app URL.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
APP_PUBLIC_URL=https://solvi-chat.onrender.com
# Currency and prices in Stripe's minor units. Defaults preserve EUR 4.99 / 8.99.
# For RUB, for example RUB 499.00 = 49900.
BILLING_CURRENCY=eur
VIP_PRICE_MINOR=499
PREMIUM_PRICE_MINOR=899

# Optional local Cloudflare Named Tunnel for a home-hosted server. Keep the token secret.
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_PUBLIC_URL=
CLOUDFLARED_PATH=

# Cloud control plane. Render injects RENDER_SERVICE_ID, RENDER_EXTERNAL_URL and PORT automatically.
# Add this secret in Render Dashboard to enable status/restart/suspend from the mobile owner panel.
RENDER_API_KEY=
RENDER_PUBLIC_URL=
RENDER_DASHBOARD_URL=
# Optional URL to this repository's Actions workflow for resume/restart/suspend while the service is stopped.
SOVLI_GITHUB_ACTIONS_URL=
